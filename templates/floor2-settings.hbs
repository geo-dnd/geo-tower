<div style="padding: 10px;">
  <div class="form-group" style="margin-bottom: 10px;">
    <label>Радиус волны холода (футы):</label>
    <div class="form-fields">
      <input type="number" name="waveRadius" value="{{waveRadius}}" min="1" style="width: 100%;">
    </div>
  </div>
  <div class="form-group" style="margin-bottom: 15px;">
    <label>Урон волны холода:</label>
    <div class="form-fields">
      <input type="text" name="waveDamage" value="{{waveDamage}}" style="width: 100%;">
    </div>
    <p class="hint">Например: 1d6, 2d8+2</p>
  </div>
  <button type="submit" style="width: 100%;"><i class="fas fa-save"></i> Сохранить</button>
</div>
