<div style="padding: 10px;">
  <h3 style="margin-top:0; border-bottom: 1px solid #777; padding-bottom: 5px;">Параметры появления</h3>
  <div class="form-group" style="margin-bottom: 10px;">
    <label>За сколько раундов доходит до центра:</label>
    <div class="form-fields">
      <input type="number" name="roundsToReach" value="{{roundsToReach}}" min="1" max="10" style="width: 100%;">
    </div>
  </div>

  <h3 style="margin-top:15px; border-bottom: 1px solid #777; padding-bottom: 5px;">Урон взрывов (стадии)</h3>
  <div class="form-group" style="margin-bottom: 10px;">
    <label>Взрыв 1 (Магма 1):</label>
    <div class="form-fields"><input type="text" name="explosion1" value="{{explosion1}}" style="width: 100%;"></div>
  </div>
  <div class="form-group" style="margin-bottom: 10px;">
    <label>Взрыв 2 (Магма 2):</label>
    <div class="form-fields"><input type="text" name="explosion2" value="{{explosion2}}" style="width: 100%;"></div>
  </div>
  <div class="form-group" style="margin-bottom: 10px;">
    <label>Взрыв 3 (Магма 3):</label>
    <div class="form-fields"><input type="text" name="explosion3" value="{{explosion3}}" style="width: 100%;"></div>
  </div>
  <div class="form-group" style="margin-bottom: 10px;">
    <label>Усиленный взрыв (4+ монстров):</label>
    <div class="form-fields"><input type="text" name="explosion4" value="{{explosion4}}" style="width: 100%;"></div>
  </div>

  <h3 style="margin-top:15px; border-bottom: 1px solid #777; padding-bottom: 5px;">Урон магмы</h3>
  <div class="form-group" style="margin-bottom: 15px;">
    <label>Урон при входе/начале хода в магме:</label>
    <div class="form-fields"><input type="text" name="magmaDamage" value="{{magmaDamage}}" style="width: 100%;"></div>
  </div>
  <button type="submit" style="width: 100%;"><i class="fas fa-save"></i> Сохранить</button>
</div>
